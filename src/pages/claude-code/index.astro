---
import '../../styles/global.css';
import CriticalBodyReset from '../../components/CriticalBodyReset.astro';
import Footer from '../../components/Footer.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import PortalThemeMeta from '../../components/portal/PortalThemeMeta.astro';
import SeoExtras from '../../components/seo/SeoExtras.astro';
import { GA_ID, OG_IMAGE, SITE_URL } from '../../config/site-seo';

const site = SITE_URL;
const pageUrl = `${site}/claude-code/`;
const title = 'Claude Code 漫游指南 | 智能体漫游';
const description =
  '43 章教程正文与排障速查：从 Agentic Coding 心智模型、多平台环境、代理循环与 Plan Mode，到项目记忆、Hooks / Skills / Plugins / SubAgents / Agent Teams / MCP、SDK 与 CI/CD 集成、完整实战工作流。';

const parts = [
  {
    label: '第一部分',
    title: '基础认知',
    chapters: [
      { n: 1, title: 'Claude Code 是什么', href: '/claude-code/what-is-claude-code/' },
      { n: 2, title: '10 倍提升效率', href: '/claude-code/core-advantages/' },
    ],
  },
  {
    label: '第二部分',
    title: '快速上手',
    chapters: [
      { n: 3, title: '安装与配置', href: '/claude-code/installation-setup/' },
      { n: 4, title: '基于第三方 API', href: '/claude-code/third-party-api/' },
      { n: 5, title: '第一个会话', href: '/claude-code/first-session/' },
      { n: 6, title: 'Slash 命令', href: '/claude-code/slash-commands/' },
      { n: 7, title: '多平台运行环境全览', href: '/claude-code/platforms-overview/' },
    ],
  },
  {
    label: '第三部分',
    title: '工作原理',
    chapters: [
      { n: 8, title: '代理循环与工具', href: '/claude-code/agent-loop/' },
      { n: 9, title: 'Plan Mode', href: '/claude-code/plan-mode/' },
    ],
  },
  {
    label: '第四部分',
    title: '项目记忆',
    chapters: [
      { n: 10, title: '项目记忆总览', href: '/claude-code/claude-md/' },
      { n: 11, title: 'CLAUDE.md 编写与维护', href: '/claude-code/claude-md-authoring/' },
      { n: 12, title: '自动记忆与 /memory', href: '/claude-code/auto-memory/' },
      { n: 13, title: 'Monorepo 与多工具记忆', href: '/claude-code/memory-monorepo-ecosystem/' },
      { n: 14, title: '团队记忆落地', href: '/claude-code/memory-team-playbook/' },
    ],
  },
  {
    label: '第五部分',
    title: '高级扩展',
    chapters: [
      { n: 15, title: 'Hooks', href: '/claude-code/hooks/' },
      { n: 16, title: 'Skills', href: '/claude-code/skills/' },
      { n: 17, title: 'Plugins', href: '/claude-code/plugins/' },
      { n: 18, title: 'SubAgents', href: '/claude-code/subagents/' },
      { n: 19, title: 'Agent Teams', href: '/claude-code/agent-teams/' },
      { n: 20, title: 'MCP', href: '/claude-code/mcp/' },
    ],
  },
  {
    label: '第六部分',
    title: 'Skill 体系',
    chapters: [
      { n: 21, title: '编码向社区精选', href: '/claude-code/skill-recommendations/' },
      { n: 22, title: '社区技能目录导读', href: '/claude-code/skill-catalog/' },
      { n: 23, title: '团队 Skill 实战', href: '/claude-code/skills-team-playbook/' },
    ],
  },
  {
    label: '第七部分',
    title: '实战与最佳实践',
    chapters: [
      { n: 24, title: '提示工程秘诀', href: '/claude-code/prompt-engineering/' },
      { n: 25, title: '完整实战工作流', href: '/claude-code/complete-workflow/' },
      { n: 26, title: '上下文管理与多代理', href: '/claude-code/context-management/' },
      { n: 27, title: '生态深度集成', href: '/claude-code/ecosystem-integration/' },
      { n: 28, title: 'Agent SDK', href: '/claude-code/agent-sdk/' },
      { n: 29, title: 'CI/CD 与代码审查', href: '/claude-code/ci-cd-integrations/' },
      { n: 30, title: '远程会话与 Channels', href: '/claude-code/remote-sessions-channels/' },
      { n: 31, title: 'Chrome 与 Web UI 测试', href: '/claude-code/chrome-browser-testing/' },
    ],
  },
  {
    label: '第八部分',
    title: '反思与进阶',
    chapters: [
      { n: 32, title: '局限性与应对', href: '/claude-code/limitations/' },
      { n: 33, title: 'AI 时代的开发者', href: '/claude-code/reflection/' },
    ],
  },
  {
    label: '第九部分',
    title: '进阶实践',
    chapters: [
      { n: 34, title: '/goal 与跨轮持续目标', href: '/claude-code/goal-mode/' },
      { n: 35, title: 'Routines 与定时自动化', href: '/claude-code/routines-automation/' },
      { n: 36, title: '调试与错误恢复', href: '/claude-code/debug-error-recovery/' },
      { n: 37, title: 'Token 成本经济学', href: '/claude-code/token-economics/' },
      { n: 38, title: '沙箱隔离机制', href: '/claude-code/sandboxing/' },
      { n: 39, title: '安全边界与权限', href: '/claude-code/security-permissions/' },
      { n: 40, title: '测试驱动与质量保障', href: '/claude-code/tdd-quality/' },
      { n: 41, title: '团队与组织级落地', href: '/claude-code/team-organization/' },
      { n: 42, title: '心智模型迁移', href: '/claude-code/mental-model-migration/' },
    ],
  },
  {
    label: '第十部分',
    title: '排障速查',
    chapters: [
      { n: 43, title: 'CLI 与配置查阅', href: '/claude-code/cli-and-settings-reference/' },
      { n: 44, title: '常见问题排查', href: '/claude-code/troubleshooting-faq/' },
    ],
  },
];

const hermesGuide = {
  href: '/hermes-agent/',
  startHref: '/hermes-agent/what-is-hermes-agent/',
  summary:
    '模型无关的自主 Agent：closed learning loop、MEMORY.md 与 Skill、Gateway 与 70+ 工具。14 章已全部发布，含架构拆解与系列自测。',
  chapters: [
    { n: 1, title: '认识 Hermes Agent', href: '/hermes-agent/what-is-hermes-agent/' },
    { n: 2, title: '安装与环境准备', href: '/hermes-agent/installation-setup/' },
    { n: 7, title: '消息网关', href: '/hermes-agent/messaging-gateway/' },
    { n: 14, title: '系列总结与自测', href: '/hermes-agent/series-summary-and-self-test/' },
  ],
};

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <CriticalBodyReset />
    <title>{title}</title>
    <meta name="description" content={description} />
    <PortalThemeMeta />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <SeoExtras
      canonical={pageUrl}
      title={title}
      description={description}
      pageType="collection"
      includeWebSiteSchema={false}
    />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ gaId: GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <div class="site-shell">
      <PortalNav
        items={[
          { href: '/', label: '站点首页' },
          { href: '/hermes-agent/', label: 'Hermes Agent' },
          { href: '/claude-code/what-is-claude-code/', label: '从第 1 章开始', variant: 'cta' },
        ]}
      />

      <main id="main-content">
        <section class="hero hero-guide" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">Claude Code · 43 章 + 排障</p>
            <h1 id="hero-title">系统掌握 <span>Claude Code</span></h1>
            <p class="hero-lede">
              这不是聊天教程，而是一份面向工程师的 Agentic Coding 指南：多平台环境、代理循环与 Plan Mode、项目记忆、Hooks / Skills / Plugins / SubAgents / Agent Teams / MCP、Agent SDK 与 CI/CD 集成，再到组织落地与排障速查。
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/claude-code/what-is-claude-code/">从第 1 章开始</a>
              <a class="btn btn-secondary" href="/claude-code/installation-setup/">直接安装配置</a>
            </div>
            <ul class="hero-highlights" aria-label="指南亮点">
              <li>CLI / IDE / Desktop / Web 多平台选型</li>
              <li>Plan Mode、Agent Teams、SubAgents 分工</li>
              <li>SDK、CI/CD、沙箱与权限治理</li>
            </ul>
          </div>

          <aside class="hero-aside" aria-label="目录结构">
            <p class="aside-label">目录结构</p>
            <ol class="aside-parts">
              {parts.map((part) => (
                <li>
                  <span class="aside-part-name">{part.label}</span>
                  <span class="aside-part-title">{part.title}</span>
                </li>
              ))}
            </ol>
          </aside>
        </section>

        <section class="metric-strip" aria-label="指南概览">
          <div class="metric">
            <strong>43</strong>
            <span>章教程正文 + 排障速查</span>
          </div>
          <div class="metric">
            <strong>10</strong>
            <span>部分，按学习路径递进编排</span>
          </div>
          <div class="metric">
            <strong>CC</strong>
            <span>面向 Claude Code 的专属知识库</span>
          </div>
          <div class="metric">
            <strong>中文</strong>
            <span>面向中文读者的系统整理</span>
          </div>
        </section>

        <section class="section" aria-labelledby="catalog-title">
          <div class="section-header">
            <p class="section-kicker">table of contents</p>
            <h2 id="catalog-title">按部分浏览全部章节</h2>
            <p>进入文档后，侧边栏仅展示本指南的章节导航，不会被其他主题分散注意力。</p>
          </div>

          <div class="catalog-grid">
            {parts.map((part) => (
              <article class="catalog-part">
                <header class="catalog-part-head">
                  <span>{part.label}</span>
                  <h3>{part.title}</h3>
                </header>
                <ul class="chapter-list">
                  {part.chapters.map((chapter) => (
                    <li>
                      <a href={chapter.href}>
                        <span class="chapter-num">{chapter.n}</span>
                        <span class="chapter-title">{chapter.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="section guide-related" aria-labelledby="hermes-title">
          <div class="section-header">
            <p class="section-kicker">more agent tracks</p>
            <h2 id="hermes-title">Hermes Agent 漫游指南</h2>
            <p>{hermesGuide.summary}</p>
          </div>

          <div class="guide-related-panel">
            <article class="guide-related-promo">
              <div class="guide-related-promo-top">
                <h3>Hermes Agent</h3>
                <span class="track-status track-status-live">已上线 · 14 章</span>
              </div>
              <p>
                侧重长期驻留、多平台 Gateway 与自编写 Skill；可与 Claude Code 配合：本地改代码，VPS 上跑 Hermes 定时巡检。
              </p>
              <div class="guide-related-actions">
                <a class="btn btn-primary" href={hermesGuide.href}>进入专题目录</a>
                <a class="btn btn-secondary" href={hermesGuide.startHref}>从第 1 章开始</a>
              </div>
            </article>

            <article class="catalog-part guide-related-catalog">
              <header class="catalog-part-head">
                <span>已发布章节</span>
                <h3>入门与核心机制</h3>
              </header>
              <ul class="chapter-list">
                {hermesGuide.chapters.map((chapter) => (
                  <li>
                    <a href={chapter.href}>
                      <span class="chapter-num">{chapter.n}</span>
                      <span class="chapter-title">{chapter.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          </div>
        </section>

        <section class="portal-cta" aria-labelledby="closing-title">
          <div class="portal-cta-inner">
            <h2 id="closing-title">准备好把 Claude Code 变成日常工程能力了吗？</h2>
            <p>从第 1 章理解 Agentic Coding 范式，或跳到安装配置直接开干。章节正文位于 /claude-code/ 路径下。</p>
            <div class="hero-actions portal-cta-actions">
              <a class="btn btn-primary" href="/claude-code/what-is-claude-code/">开始第 1 章</a>
            </div>
          </div>
        </section>
      </main>

      <div class="home-footer-slot">
        <Footer hydrate="load" />
      </div>
    </div>

  </body>
</html>
