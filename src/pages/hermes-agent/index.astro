---
import '../../styles/global.css';
import CriticalBodyReset from '../../components/CriticalBodyReset.astro';
import Footer from '../../components/Footer.astro';
import PortalNav from '../../components/portal/PortalNav.astro';
import PortalThemeMeta from '../../components/portal/PortalThemeMeta.astro';
import SeoExtras from '../../components/seo/SeoExtras.astro';
import { GA_ID, OG_IMAGE, SITE_URL } from '../../config/site-seo';

const site = SITE_URL;
const pageUrl = `${site}/hermes-agent/`;
const title = 'Hermes Agent 漫游指南 | 智能体漫游';
const description =
  '17 章系统掌握 Hermes Agent：closed learning loop、Hooks 与 Kanban、Gateway 与插件、Checkpoints 与 API Server，以及架构拆解与社区贡献。';

const parts = [
  {
    label: '第一部分',
    title: '入门',
    chapters: [
      { n: 1, title: '认识 Hermes Agent', href: '/hermes-agent/what-is-hermes-agent/' },
      { n: 2, title: '安装与环境准备', href: '/hermes-agent/installation-setup/' },
      { n: 3, title: '第一次对话', href: '/hermes-agent/first-conversation/' },
    ],
  },
  {
    label: '第二部分',
    title: '核心机制',
    chapters: [
      { n: 4, title: '记忆、学习与 Skill', href: '/hermes-agent/memory-learning-skills/' },
      { n: 5, title: '配置与个性化', href: '/hermes-agent/configuration-personalization/' },
      { n: 6, title: '工具系统', href: '/hermes-agent/tools-system/' },
    ],
  },
  {
    label: '第三部分',
    title: '实战',
    chapters: [
      { n: 7, title: '消息网关', href: '/hermes-agent/messaging-gateway/' },
      { n: 8, title: '技能系统实战', href: '/hermes-agent/skills-in-practice/' },
      { n: 9, title: '事件钩子', href: '/hermes-agent/event-hooks/' },
      { n: 10, title: 'Kanban 多 Agent 看板', href: '/hermes-agent/kanban-multi-agent-board/' },
      { n: 11, title: '高级特性', href: '/hermes-agent/advanced-features/' },
    ],
  },
  {
    label: '第四部分',
    title: '进阶',
    chapters: [
      {
        n: 12,
        title: '安全、性能与最佳实践',
        href: '/hermes-agent/security-performance-best-practices/',
      },
      { n: 13, title: '插件系统', href: '/hermes-agent/plugins-system/' },
      { n: 14, title: '架构拆解', href: '/hermes-agent/architecture-deep-dive/' },
      { n: 15, title: '从零实现类似 Agent', href: '/hermes-agent/build-your-own-agent/' },
      { n: 16, title: '贡献与社区', href: '/hermes-agent/contributing-and-community/' },
      { n: 17, title: '系列总结与自测', href: '/hermes-agent/series-summary-and-self-test/' },
    ],
  },
];

const claudeGuide = {
  href: '/claude-code/',
  startHref: '/claude-code/what-is-claude-code/',
  summary:
    '面向代码库的 Agentic Coding：代理循环、Plan Mode、CLAUDE.md、Hooks / Skills / SubAgents / MCP 与完整工程工作流。',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <CriticalBodyReset />
    <title>{title}</title>
    <meta name="description" content={description} />
    <PortalThemeMeta />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <SeoExtras
      canonical={pageUrl}
      title={title}
      description={description}
      pageType="collection"
      includeWebSiteSchema={false}
    />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ gaId: GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <div class="site-shell">
      <PortalNav
        items={[
          { href: '/', label: '站点首页' },
          { href: '/claude-code/', label: 'Claude Code' },
          { href: '/hermes-agent/what-is-hermes-agent/', label: '从第 1 章开始', variant: 'cta' },
        ]}
      />

      <main id="main-content">
        <section class="hero hero-guide" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">Hermes Agent · 17 章</p>
            <h1 id="hero-title">系统掌握 <span>Hermes Agent</span></h1>
            <p class="hero-lede">
              Nous Research 出品的模型无关自主 Agent：不绑定 IDE，可跑 CLI、TUI、Gateway 与 Cron。本指南从 closed learning loop、记忆与 Skill，到工具审批、多平台网关、架构拆解与自测验收。
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/hermes-agent/what-is-hermes-agent/">从第 1 章开始</a>
              <a class="btn btn-secondary" href="/hermes-agent/installation-setup/">直接安装配置</a>
            </div>
            <ul class="hero-highlights" aria-label="指南亮点">
              <li>MEMORY.md / USER.md 与 Skill 自改进闭环</li>
              <li>70+ 工具、MCP 与多 backend 执行环境</li>
              <li>Gateway 20+ 平台与 Cron 定时推送</li>
            </ul>
          </div>

          <aside class="hero-aside" aria-label="目录结构">
            <p class="aside-label">目录结构</p>
            <ol class="aside-parts">
              {parts.map((part) => (
                <li>
                  <span class="aside-part-name">{part.label}</span>
                  <span class="aside-part-title">{part.title}</span>
                </li>
              ))}
            </ol>
          </aside>
        </section>

        <section class="metric-strip" aria-label="指南概览">
          <div class="metric">
            <strong>14</strong>
            <span>章节，从入门到架构与自测</span>
          </div>
          <div class="metric">
            <strong>4</strong>
            <span>部分，按学习路径递进编排</span>
          </div>
          <div class="metric">
            <strong>闭环</strong>
            <span>记忆、Skill 与 Curator 自改进</span>
          </div>
          <div class="metric">
            <strong>中文</strong>
            <span>面向中文读者的系统整理</span>
          </div>
        </section>

        <section class="section" aria-labelledby="catalog-title">
          <div class="section-header">
            <p class="section-kicker">table of contents</p>
            <h2 id="catalog-title">按部分浏览全部章节</h2>
            <p>进入文档后，侧边栏仅展示本指南的章节导航，不会被其他主题分散注意力。</p>
          </div>

          <div class="catalog-grid">
            {parts.map((part) => (
              <article class="catalog-part">
                <header class="catalog-part-head">
                  <span>{part.label}</span>
                  <h3>{part.title}</h3>
                </header>
                <ul class="chapter-list">
                  {part.chapters.map((chapter) => (
                    <li>
                      <a href={chapter.href}>
                        <span class="chapter-num">{chapter.n}</span>
                        <span class="chapter-title">{chapter.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="section guide-related" aria-labelledby="claude-title">
          <div class="section-header">
            <p class="section-kicker">more agent tracks</p>
            <h2 id="claude-title">Claude Code 漫游指南</h2>
            <p>{claudeGuide.summary}</p>
          </div>

          <div class="guide-related-panel">
            <article class="guide-related-promo">
              <div class="guide-related-promo-top">
                <h3>Claude Code</h3>
                <span class="track-status track-status-live">已上线 · 25 章</span>
              </div>
              <p>
                侧重本地仓库上下文与工程交付；可与 Hermes 配合：Claude Code 改代码，Hermes 在 VPS 上跑 Gateway 巡检与 Cron 提醒。
              </p>
              <div class="guide-related-actions">
                <a class="btn btn-primary" href={claudeGuide.href}>进入专题目录</a>
                <a class="btn btn-secondary" href={claudeGuide.startHref}>从第 1 章开始</a>
              </div>
            </article>

            <article class="catalog-part guide-related-catalog">
              <header class="catalog-part-head">
                <span>官方文档</span>
                <h3>Hermes 延伸阅读</h3>
              </header>
              <ul class="chapter-list">
                <li>
                  <a href="https://hermes-agent.nousresearch.com/docs/" target="_blank" rel="noopener noreferrer">
                    <span class="chapter-num">↗</span>
                    <span class="chapter-title">Hermes 官方文档</span>
                  </a>
                </li>
                <li>
                  <a
                    href="https://github.com/NousResearch/hermes-agent"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="chapter-num">↗</span>
                    <span class="chapter-title">GitHub 仓库</span>
                  </a>
                </li>
                <li>
                  <a href="/hermes-agent/series-summary-and-self-test/">
                    <span class="chapter-num">14</span>
                    <span class="chapter-title">系列总结与自测</span>
                  </a>
                </li>
              </ul>
            </article>
          </div>
        </section>

        <section class="portal-cta" aria-labelledby="closing-title">
          <div class="portal-cta-inner">
            <h2 id="closing-title">准备好在一台机器上长期跑 Hermes 了吗？</h2>
            <p>从第 1 章理解 closed learning loop，或跳到安装配置直接开干。章节正文位于 /hermes-agent/ 路径下。</p>
            <div class="hero-actions portal-cta-actions">
              <a class="btn btn-primary" href="/hermes-agent/what-is-hermes-agent/">开始第 1 章</a>
            </div>
          </div>
        </section>
      </main>

      <div class="home-footer-slot">
        <Footer hydrate="load" />
      </div>
    </div>

  </body>
</html>
