---
import AgentLab from '../components/AgentLab.svelte';
import '../styles/global.css';

const site = 'https://agent.jeffjade.com';
const title = '智能体漫游 | agent.jeffjade.com';
const description =
  '一个面向工程师、创造者与普通人的 Agent 探索性网站，系统梳理 Claude Code、hermes-agent、Agent 工作流、SEO 与 AEO。';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '智能体漫游',
  url: site,
  inLanguage: 'zh-CN',
  description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f7" />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}/og.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JXTFG9M3EK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JXTFG9M3EK');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="home-nav" aria-label="主导航">
        <a class="brand-mark" href="/">
          <span class="brand-glyph" aria-hidden="true">智</span>
          <span>智能体漫游</span>
        </a>
        <nav class="nav-links" aria-label="站点导航">
          <a href="/get-started/">开始</a>
          <a href="/claude-code/">Claude Code</a>
          <a href="/hermes-agent/">hermes-agent</a>
          <a href="/seo-aeo/">SEO/AEO</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-scene" aria-hidden="true">
            <span class="signal-line"></span>
            <span class="signal-line"></span>
            <span class="signal-line"></span>
          </div>
          <div class="hero-copy">
            <p class="eyebrow">agent.jeffjade.com</p>
            <h1 id="hero-title">把 Agent 从<span>会聊天</span>带到能完成事情。</h1>
            <p class="hero-lede">
              这是一个探索 Agent 实践的知识站：既给工程师拆解 Claude Code、hermes-agent 与工作流，也给普通人提供可靠的日常 Agent 使用路径。内容同时面向搜索引擎与 LLM，让知识能被人读懂，也能被机器引用。
            </p>
            <div class="hero-actions">
              <a class="button primary" href="/get-started/">进入知识库</a>
              <a class="button" href="/claude-code/">看 Claude Code 路线</a>
            </div>
          </div>
          <AgentLab client:load />
        </section>

        <section class="metric-strip" aria-label="站点重点">
          <div class="metric">
            <strong>3</strong>
            <span>工程、个人、组织三类 Agent 入口</span>
          </div>
          <div class="metric">
            <strong>2</strong>
            <span>Claude Code 与 hermes-agent 深度路线</span>
          </div>
          <div class="metric">
            <strong>AEO</strong>
            <span>面向 LLM 摘要、引用与检索的内容结构</span>
          </div>
          <div class="metric">
            <strong>GA4</strong>
            <span>内置 G-JXTFG9M3EK 访问分析</span>
          </div>
        </section>

        <section class="section kicker" aria-labelledby="paths-title">
          <div class="section-header">
            <p>exploration routes</p>
            <h2 id="paths-title">不是“工具清单”，而是一张可行动的 Agent 地图。</h2>
            <p>
              Agent 的价值不止在回答问题，而在把上下文、工具、权限、记忆和反馈闭环组合起来。这个站点把技术细节翻译成路线，让不同背景的人都能找到下一步。
            </p>
          </div>
          <div class="path-grid">
            <article class="path-card">
              <span class="tag">For engineers</span>
              <h3>从仓库现场出发</h3>
              <p>围绕 Claude Code、命令行、MCP、测试、审阅和发布流程，建立“可验证的自动化协作”。</p>
            </article>
            <article class="path-card">
              <span class="tag">For builders</span>
              <h3>沉淀长期 Agent</h3>
              <p>研究 hermes-agent 这类自托管路线，把记忆、技能、消息入口和模型选择变成长期生产力系统。</p>
            </article>
            <article class="path-card">
              <span class="tag">For everyone</span>
              <h3>把日常任务变简单</h3>
              <p>旅行、学习、写作、家庭计划、资料整理，都可以从“目标、约束、检查点”三件事开始。</p>
            </article>
          </div>
        </section>

        <section class="section" aria-labelledby="map-title">
          <div class="section-header">
            <p>human + llm readable</p>
            <h2 id="map-title">内容同时服务浏览器搜索、AI 摘要和真实决策。</h2>
            <p>
              每篇核心页面都会围绕清晰标题、摘要、FAQ、实践步骤、风险边界和可引用结论设计。这样更适合 SEO，也更适合 LLM 在回答中正确引用。
            </p>
          </div>
          <div class="map-panel">
            <div class="map-note">
              <p>
                首页负责吸引与分流，Starlight 文档负责深读、搜索和持续扩展。后续可以增加工具评测、Agent 案例库、Prompt 模板、MCP 目录、周报与实验日志。
              </p>
              <a href="/seo-aeo/">查看 SEO/AEO 设计</a>
            </div>
            <div class="map-table" role="table" aria-label="Agent 内容矩阵">
              <div class="map-row" role="row">
                <div role="cell"><strong>学习</strong></div>
                <div role="cell"><span>概念、术语、示例、常见误区</span></div>
                <div role="cell"><span>适合新读者与 LLM 摘要</span></div>
              </div>
              <div class="map-row" role="row">
                <div role="cell"><strong>实践</strong></div>
                <div role="cell"><span>Claude Code、hermes-agent、MCP、权限</span></div>
                <div role="cell"><span>适合工程师和独立创造者</span></div>
              </div>
              <div class="map-row" role="row">
                <div role="cell"><strong>评估</strong></div>
                <div role="cell"><span>成本、自治程度、可解释性、安全边界</span></div>
                <div role="cell"><span>适合采购、选型和长期运营</span></div>
              </div>
            </div>
          </div>

          <div class="closing-band">
            <h2>下一步：让这个站点成为你的 Agent 实验基地。</h2>
            <p>
              我已经预留了内容结构和技术底座。接下来可以持续补充真实实验记录、工具横评、视频脚本、中文搜索词库、英文摘要页，以及给 LLM 抓取的结构化索引。
            </p>
            <a class="button primary" href="/get-started/">开始阅读</a>
          </div>
        </section>
      </main>

      <footer class="home-footer">
        <p>智能体漫游 · agent.jeffjade.com · Built with Astro, Starlight, Svelte and Tailwind CSS.</p>
      </footer>
    </div>
  </body>
</html>
