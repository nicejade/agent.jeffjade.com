---
import '../styles/global.css';

const site = 'https://agent.jeffjade.com';
const title = '智能体漫游 | agent.jeffjade.com';
const description =
  '专注于快速掌握主流 AI Agent，如 Claude Code、Hermes Agent 等。通过实用教程、案例演示和最新资讯，让开发者和 AI 爱好者轻松上手，探索智能体应用潜力，提升学习效率与实践能力。';

const pillars = [
  {
    title: '实用教程',
    body: '按任务拆解机制与步骤，从安装配置到 Hooks、Skills、MCP，形成可复用的学习路径。',
  },
  {
    title: '案例演示',
    body: '用真实仓库与命令展示 Agent 如何读代码、改文件、跑测试，结论可对照验证。',
  },
  {
    title: '持续更新',
    body: '跟进主流 Agent 能力与边界变化，把新特性与踩坑经验写回文档。',
  },
];

const tracks = [
  {
    name: 'Claude Code',
    status: '已上线',
    statusClass: 'track-status-live',
    summary: '18 章系统指南：Agentic Coding 心智模型、代理循环、Plan Mode 与完整工程工作流。',
    href: '/claude-code/',
    cta: '进入专题',
    available: true,
  },
  {
    name: 'Hermes Agent',
    status: '筹备中',
    statusClass: 'track-status-soon',
    summary: '面向多工具编排与自动化场景的 Agent 专题，教程与案例正在整理。',
    href: undefined,
    cta: '即将推出',
    available: false,
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '智能体漫游',
  url: site,
  inLanguage: 'zh-CN',
  description,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f7" />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}/og.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JXTFG9M3EK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JXTFG9M3EK');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="home-nav" aria-label="主导航">
        <a class="brand-mark" href="/">
          <span class="brand-glyph" aria-hidden="true">智</span>
          <span>智能体漫游</span>
        </a>
        <nav class="nav-links" aria-label="站点导航">
          <a href="/claude-code/">Claude Code</a>
          <a class="nav-cta" href="/claude-code/">开始学习</a>
        </nav>
      </header>

      <main>
        <section class="hero hero-portal" aria-labelledby="portal-title">
          <div class="hero-scene" aria-hidden="true">
            <span class="signal-line"></span>
            <span class="signal-line"></span>
            <span class="signal-line"></span>
          </div>
          <div class="hero-copy hero-copy-portal">
            <p class="eyebrow">AI Agent · 中文知识库</p>
            <h1 id="portal-title">智能体<span>漫游</span></h1>
            <p class="hero-lede hero-lede-portal">
              专注于快速掌握主流 AI Agent，如 Claude Code、Hermes Agent 等。通过实用教程、案例演示和最新资讯，让开发者和 AI 爱好者轻松上手，探索智能体应用潜力，提升学习效率与实践能力。
            </p>
            <div class="hero-actions">
              <a class="button primary" href="/claude-code/">探索 Claude Code</a>
              <a class="button" href="/claude-code-guide/what-is-claude-code/">阅读第 1 章</a>
            </div>
          </div>
        </section>

        <section class="section kicker" aria-labelledby="pillars-title">
          <div class="section-header section-header-center">
            <p>learn · build · ship</p>
            <h2 id="pillars-title">三条路径，把 Agent 用进真实工作</h2>
          </div>
          <div class="path-grid">
            {pillars.map((pillar) => (
              <article class="path-card path-card-minimal">
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section" aria-labelledby="tracks-title">
          <div class="section-header">
            <p>agent tracks</p>
            <h2 id="tracks-title">选择你的 Agent 专题</h2>
            <p>每个专题独立编排目录与侧边栏，阅读时只聚焦当前工具。</p>
          </div>
          <div class="track-grid">
            {tracks.map((track) => (
              <article class={`track-card ${track.available ? 'track-card-live' : 'track-card-muted'}`}>
                <div class="track-card-top">
                  <h3>{track.name}</h3>
                  <span class={`track-status ${track.statusClass}`}>{track.status}</span>
                </div>
                <p>{track.summary}</p>
                {track.available && track.href ? (
                  <a class="track-link" href={track.href}>
                    {track.cta}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M5 12h14M13 6l6 6-6 6"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                ) : (
                  <span class="track-link track-link-disabled" aria-disabled="true">{track.cta}</span>
                )}
              </article>
            ))}
          </div>
        </section>

        <section class="portal-cta" aria-label="行动号召">
          <div class="portal-cta-inner">
            <h2>从 Claude Code 开始你的第一场 Agent 会话</h2>
            <p>安装、权限、代理循环与 Plan Mode，按章节循序渐进。</p>
            <a class="button primary" href="/claude-code-guide/installation-setup/">查看安装指南</a>
          </div>
        </section>
      </main>

      <footer class="home-footer">
        <p>智能体漫游 · agent.jeffjade.com · Built with Astro, Starlight and Tailwind CSS.</p>
      </footer>
    </div>
  </body>
</html>
