---
import { globalSeoHead, OG_IMAGE, SITE_NAME } from '../../config/site-seo';
import { buildWebPageSchema, buildWebSiteSchema } from '../../lib/seo-structured-data';

interface Props {
  canonical: string;
  title: string;
  description: string;
  pageType?: 'website' | 'webpage';
  includeWebSiteSchema?: boolean;
}

const {
  canonical,
  title,
  description,
  pageType = 'website',
  includeWebSiteSchema = pageType === 'website',
} = Astro.props;

const schemas = includeWebSiteSchema
  ? [buildWebSiteSchema(description)]
  : [
      buildWebPageSchema({
        name: title,
        url: canonical,
        description,
      }),
    ];

if (includeWebSiteSchema && pageType === 'website') {
  schemas.push(
    buildWebPageSchema({
      name: title,
      url: canonical,
      description,
    }),
  );
}
---

<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta property="og:locale" content="zh-CN" />
<meta property="og:site_name" content={SITE_NAME} />
<meta name="twitter:site" content="@MarshalXuan" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<link rel="sitemap" href="/sitemap-index.xml" />
{globalSeoHead.map((entry) => {
  const Tag = entry.tag;
  return <Tag {...entry.attrs} />;
})}
{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
