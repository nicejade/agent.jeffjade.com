---
import { globalSeoHead, ROBOTS_CONTENT, twitterMetaHead } from '../../config/site-seo';
import {
  buildCollectionPageSchema,
  buildWebPageSchema,
  buildWebSiteSchema,
} from '../../lib/seo-structured-data';

interface Props {
  canonical: string;
  title: string;
  description: string;
  pageType?: 'website' | 'webpage' | 'collection';
  includeWebSiteSchema?: boolean;
}

const {
  canonical,
  title,
  description,
  pageType = 'website',
  includeWebSiteSchema = pageType === 'website',
} = Astro.props;

const schemas = includeWebSiteSchema ? [buildWebSiteSchema(description)] : [];

if (pageType === 'collection') {
  schemas.push(
    buildCollectionPageSchema({
      name: title,
      url: canonical,
      description,
    }),
  );
} else {
  schemas.push(
    buildWebPageSchema({
      name: title,
      url: canonical,
      description,
    }),
  );
}
---

<meta name="robots" content={ROBOTS_CONTENT} />
{twitterMetaHead(title, description).map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
{globalSeoHead.map((entry) => {
  const Tag = entry.tag;
  return <Tag {...entry.attrs} />;
})}
{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
