---
import { SITE_DEFAULT_DESCRIPTION, twitterMetaHead } from '../../config/site-seo';
import {
  buildArticleGraph,
  canonicalFromHead,
} from '../../lib/seo-structured-data';

const route = Astro.locals.starlightRoute;
const { head } = route;
const canonical = canonicalFromHead(head);
const title = route.entry.data.title;
const description = route.entry.data.description ?? SITE_DEFAULT_DESCRIPTION;

const structuredData =
  canonical !== undefined ? buildArticleGraph(route, canonical) : [];
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{twitterMetaHead(title, description).map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
{structuredData.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
